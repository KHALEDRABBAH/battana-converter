{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/convert.js": {
      "maxDuration": 300
    },
    "api/feedback.js": {
      "maxDuration": 30
    },
    "api/blob-upload.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
